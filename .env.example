# Copiar a .env y completar. .env NO se commitea.
# Estos valores se inyectan al contenedor canelary-server via docker-compose.yml.

# Conexion a SQL Server (auth SQL, no Windows auth)
CANELARY_DB_CONNECTION=Server=rafa;Database=VisualTernera;User Id=canelary_app;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True

# Puerto del Server publicado al host (opcional, override del default).
# La WebApp NO publica puerto: se accede via Traefik (red traefik-public).
SERVER_HOST_PORT=5262
